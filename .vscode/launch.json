{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Iniciar sistema de notas",
      "program": "${workspaceFolder}/server.js",
      "runtimeArgs": ["--disable-warning=ExperimentalWarning"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "rodando em (http://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
